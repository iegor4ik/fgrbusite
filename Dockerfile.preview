FROM debian:12-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    libreoffice-calc \
    libreoffice-writer \
    libreoffice-impress \
    fonts-dejavu-core \
    fonts-liberation \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /data/uploads/documents /data/document-previews

CMD ["tail", "-f", "/dev/null"]
